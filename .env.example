# ==============================================================================
# 📡 Servidor LiveKit
# ==============================================================================
# Opção A: Servidor Local (Docker / livekit-server --dev)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Opção B: LiveKit Cloud (https://cloud.livekit.io)
# LIVEKIT_URL=wss://seu-projeto.livekit.cloud
# LIVEKIT_API_KEY=sua_api_key
# LIVEKIT_API_SECRET=seu_api_secret

# ==============================================================================
# ☁️ Google Cloud Vertex AI (Gemini Live 2.5 Realtime Native Audio)
# ==============================================================================
# ID do Projeto no Google Cloud Console
GOOGLE_CLOUD_PROJECT=seu-project-id-gcp

# Região da Vertex AI (padrão: us-central1)
GOOGLE_CLOUD_LOCATION=us-central1

# Caminho para a chave JSON da Service Account (com papel 'Vertex AI User')
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# (Opcional) Google AI Studio API Key (apenas caso decida alternar para vertexai=false)
# GOOGLE_API_KEY=your_gemini_api_key_here

# ==============================================================================
# 🎛️ Configurações de Logs
# ==============================================================================
# Nível de log: 'info' para saída limpa e elegante, 'debug' para logs detalhados
LOG_LEVEL=info
